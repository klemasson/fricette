# Copie ce fichier en ".env.local" pour tester sur ton ordinateur.
# Sur Vercel, ces valeurs se saisissent dans Settings > Environment Variables.

# --- Obligatoire ---------------------------------------------------------
# Clé API Anthropic (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=sk-ant-...
# Modèle utilisé. claude-haiku-5-5 coûte moins cher, claude-sonnet-5-5 cuisine mieux.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Une longue phrase aléatoire (au moins 32 caractères) pour signer les cookies.
SESSION_SECRET=remplace-moi-par-une-longue-chaine-aleatoire

# Adresse publique du site, sans "/" final
SITE_URL=http://localhost:3000

# Base Upstash Redis (compteur des essais gratuits). Créée depuis Vercel > Storage.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Abonnement Stripe ---------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
# Identifiant du prix mensuel créé dans Stripe (commence par price_)
STRIPE_PRICE_ID=price_...

# --- Réglages ------------------------------------------------------------
# Le carnet de recettes est illimité et gratuit. Ces limites concernent le « sur mesure » par l'IA.
FREE_RECIPES_PER_DAY=1
FREE_PHOTOS_PER_DAY=1
# Plafond de sécurité pour les abonnés (protège ta facture)
PRO_RECIPES_PER_DAY=60
PRICE_LABEL=4,90 CHF / mois

# --- Optionnel : retrouver son abonnement sur un autre appareil ----------
# Clé Resend (resend.com) et adresse d'envoi validée
RESEND_API_KEY=
EMAIL_FROM=Fricette <bonjour@fricette.ch>

# Mode simulation : renvoie de fausses recettes sans appeler Claude (tests gratuits)
MOCK_AI=0

# --- Photos des recettes (seulement sur ton ordinateur, pour « npm run photos ») ---
# Jeton Replicate : replicate.com > Account > API tokens
REPLICATE_API_TOKEN=
# Modèle d'images. flux-schnell ≈ 0,003 $ par photo ; black-forest-labs/flux-1.1-pro = plus beau, plus cher.
REPLICATE_MODEL=black-forest-labs/flux-schnell
